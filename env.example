# Portas do servidor SMTP (separadas por vírgula)
# Nota: Portas < 1024 requerem privilégios root
SMTP_PORTS=25,587,465,2525

# Host do servidor (sempre 0.0.0.0 em containers - não alterar)
# HOST=0.0.0.0

# Domínio e subdomínio
DOMAIN=prescreva.me
SMTP_SUBDOMAIN=mail

# Permitir autenticação inválida (para desenvolvimento)
ALLOW_INVALID_AUTH=false

# Permitir autenticação insegura
ALLOW_INSECURE_AUTH=true

# Desabilitar STARTTLS (opcional)
DISABLE_STARTTLS=false

# Credenciais SMTP (quando ALLOW_INVALID_AUTH=false)
SMTP_USERNAME=admin
SMTP_PASSWORD=change_this_password

# Cloudflare API Token (para configuração automática de DNS)
# Obtenha em: https://dash.cloudflare.com/profile/api-tokens
# Permissões necessárias: Zone.DNS (Edit)
CLOUDFLARE_API_TOKEN=

# IP público (será detectado automaticamente pelo script setup)
PUBLIC_IP=

